# Build arguments for the frontend image in docker-compose.yml.
# Copy to .env and use the same values as frontend/.env (public web config, not secrets).
# Empty API/Realtime URLs fall back to http://localhost:3000/api/v1 and http://localhost:3001.
VITE_API_URL=
VITE_REALTIME_URL=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
